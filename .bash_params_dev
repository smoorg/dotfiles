#!/bin/sh

# devkitpro
dkp=/opt/devkitpro
if [ -d $dkp ]; then
    export DEVKITPRO=$dkp
    export DEVKITARM=$dkp/devkitARM
    export DEVKITPPC=$dkp/devkitPPC
fi

# dotnet
export DOTNET_TOOLS=$HOME/.dotnet/tools

# javascript
if [ -x yarn ]; then
  YARN_GLOBAL=$(yarn global bin)
  source /usr/share/nvm/init-nvm.sh
fi

# ruby
RVM=""
if [ `tty` = /dev/tty1 -a -x ruby -a -x rvm ]; then
    export GEM_HOME=$HOME/.cache/gem
    # Load Ruby Version Manager (RVM) into a shell session *as a function*
    if [[ -s "/usr/share/rvm/scripts/rvm" ]]; then
        export PATH="$PATH:$HOME/.rvm/bin"
        source "/usr/share/rvm/scripts/rvm" 
        rvm use 2.7.7
        # Add RVM to PATH for scripting. Make sure this is the last PATH variable change.
        RVM="$PATH:$HOME/.rvm/bin"

	sourcefile $HOME/.cache/yay/rvm/rvm.sh
    fi
fi

# golang
export GOBIN=$HOME/.local/share/go/bin
export GOPRIVATE=go.bufbuild,buf.build,buf.build/gen/go
# direnv (recognizes .envrc files)
eval "$(direnv hook bash)"

# Added by Toolbox App
TOOLBOX=$HOME/.local/share/JetBrains/Toolbox/scripts

sources=(
    $DOTNET_TOOLS
    $YARN_GLOBAL
    $DEVKITPRO
    $RVM
    $GEM_HOME
    $TOOLBOX
    $GOBIN
    /opt/zig
)

# flatten the list
# replace spaces echo generates between elements with colons
paths=$(echo ${sources[*]} | tr ' ' :)

export PATH=$PATH:$paths

